<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SnapNova.App.ViewModels"
             xmlns:views="using:SnapNova.App.Views"
             x:Class="SnapNova.App.App"
             Name="SnapNova"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SnapNova/Theme/Colors.axaml" />
        <ResourceInclude Source="avares://SnapNova/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Pages of the main window -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:GalleryViewModel">
      <views:GalleryView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Orange accent instead of system blue: check marks, radio buttons, selection, switches, focus -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#FFFF8C00"
                               RegionColor="#FF232323"
                               AltHigh="#FF232323"
                               ListLow="#FF3A3A3A"
                               ListMedium="#FF404040"
                               ChromeMediumLow="#FF323232"
                               ChromeMedium="#FF3A3A3A"
                               ChromeLow="#FF2A2A2A"
                               ChromeAltLow="#FFFFFFFF"
                               BaseHigh="#FFFFFFFF" />
        <ColorPaletteResources x:Key="Light"
                               Accent="#FFE07B00"
                               RegionColor="#FFFFFFFF"
                               BaseHigh="#FF1E1E1E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SnapNova/Theme/Styles.axaml" />
    <StyleInclude Source="avares://SnapNova/Theme/SnapNova.axaml" />
  </Application.Styles>

</Application>
