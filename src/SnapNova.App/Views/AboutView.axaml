<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:SnapNova.App.Controls"
             x:Class="SnapNova.App.Views.AboutView">

  <UserControl.Resources>
    <!-- One license row: name (+ version, note) left, license pill and open button right -->
    <DataTemplate x:Key="LicenseRow">
      <Border Classes="raised" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Classes="small muted" Text="{Binding Version}" IsVisible="{Binding HasVersion}" VerticalAlignment="Center" />
            <TextBlock Classes="small muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Classes="countpill" Margin="12,0">
            <TextBlock Classes="small" Text="{Binding License}" FontWeight="SemiBold" />
          </Border>
          <Button Grid.Column="2" Classes="tool" ToolTip.Tip="{DynamicResource AboutOpenFile}"
                  Command="{Binding $parent[UserControl].DataContext.OpenLicenseCommand}" CommandParameter="{Binding}">
            <PathIcon Data="{StaticResource IconOpenInNew}" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,16,0">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*">
          <Path Classes="logo" Width="84" Height="84" Margin="0,0,24,0" />
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="SnapNova" FontSize="28" FontWeight="Bold" />
              <Border Classes="pill accent" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="muted" Text="{DynamicResource AboutTagline}" TextWrapping="Wrap" />
            <TextBlock Classes="small muted" Text="© 2026 Sven Klocke · sksdesign | complicatiion · MIT License" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Command="{Binding OpenWebsiteCommand}">
                <ctl:IconLabel Icon="{StaticResource IconEarth}" Text="sksdesign.de" />
              </Button>
              <Button Command="{Binding OpenLicensesCommand}">
                <ctl:IconLabel Icon="{StaticResource IconLicense}" Text="{DynamicResource AboutLicensesButton}" />
              </Button>
              <Button Classes="primary" Command="{Binding OpenProjectCommand}">
                <ctl:IconLabel Icon="{StaticResource IconGithub}" Text="{DynamicResource AboutRepository}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <ctl:IconLabel Icon="{StaticResource IconShieldCheck}" Text="{DynamicResource AboutPrivacyTitle}" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Classes="muted" Text="{DynamicResource AboutPrivacy}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <ctl:IconLabel Icon="{StaticResource IconLicense}" Text="{DynamicResource AboutLicenses}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
          <TextBlock Classes="section" Text="{DynamicResource AboutSectionSnapNova}" Margin="2,4,0,2" />
          <ItemsControl ItemsSource="{Binding Documents}" ItemTemplate="{StaticResource LicenseRow}" />
          <TextBlock Classes="section" Text="{DynamicResource AboutSectionThirdParty}" Margin="2,8,0,2" />
          <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource LicenseRow}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
