<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- SnapNova additions to the shared styles (editor toolbar, swatches, gallery cards, capture buttons) -->

  <Style Selector="Border.divider.vertical">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Editor tools: square icon buttons, selected tool filled with the accent -->
  <Style Selector="ListBox.tools, ListBox.swatches">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.tools ListBoxItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ListBox.tools ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
  </Style>
  <Style Selector="ListBox.tools ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
  </Style>
  <Style Selector="ListBox.tools ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>

  <!-- Colour swatches: ring around the selected colour -->
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentText}" />
  </Style>

  <!-- Gallery -->
  <Style Selector="ListBox.gallery">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.gallery ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.gallery ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.gallery ListBoxItem Border.thumbcard">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ListBox.gallery ListBoxItem:pointerover Border.thumbcard">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentText}" />
  </Style>
  <Style Selector="ListBox.gallery ListBoxItem:selected Border.thumbcard">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
  </Style>

  <!-- Hotkey field: looks like a text box, shows the key combination -->
  <Style Selector="TextBox.hotkey">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Width" Value="200" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="TextBox.hotkey:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
  </Style>

  <!-- Large capture buttons on the empty gallery -->
  <Style Selector="Button.capture">
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Recording indicator in the header -->
  <Style Selector="Button.recording">
    <Setter Property="Background" Value="{DynamicResource BrushRecord}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- ===================================================== v0.0.3 -->

  <!-- Uniform sizes app-wide: all text buttons, drop-downs, inputs and hotkey fields of settings rows share one width -->
  <Style Selector="ComboBox.field, TextBox.field, NumericUpDown.field">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="TextBox.hotkey">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector="Button.field">
    <Setter Property="Width" Value="140" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Symbol-only buttons (text in the tooltip) -->
  <Style Selector="Button.tool">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
  </Style>
  <Style Selector="Button.tool.primary">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
  </Style>
  <Style Selector="Button.tool.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>
  <Style Selector="Button.tool.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}" />
  </Style>

  <!-- Square tool selection and round colour selection in the editor (1:1, not stretched) -->
  <Style Selector="ListBox.tools ListBoxItem">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="15" />
  </Style>

  <!-- Icon rail (sidebar): always collapsed -->
  <Style Selector="Button.rail, ToggleButton.rail">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail PathIcon, ToggleButton.rail PathIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
  </Style>
  <Style Selector="ToggleButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
  </Style>
  <Style Selector="ToggleButton.rail:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}" />
  </Style>
  <Style Selector="Button.rail.recording PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushRecord}" />
  </Style>
  <Style Selector="Ellipse.lastdot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,6,6,0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Filter chips: the active one filled in accent colour with a soft glow -->
  <Style Selector="ToggleButton.filter">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BoxShadow" Value="0 0 14 2 #66FF8C00" />
  </Style>
  <Style Selector="ToggleButton.filter:checked">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>
  <Style Selector="ToggleButton.filter:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>
  <Style Selector="Border.countpill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Destructive menu entries turn red on hover -->
  <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="MenuItem.danger:pointerover">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="MenuItem.danger:pointerover PathIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Gallery selection (own multi-selection) -->
  <Style Selector="Border.thumbcard">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.thumbcard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentText}" />
  </Style>
  <Style Selector="Border.thumbcard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
  </Style>

  <!-- Logo (vector, no glow) -->
  <Style Selector="Path.logo">
    <Setter Property="Data" Value="{StaticResource LogoGeometry}" />
    <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Expander in dialogs and cards -->
  <Style Selector="Expander.details">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- ===================================================== v0.0.5: gallery header, pills, selection -->
  <!-- Filter chips and the count pill share one size (count: room for 3 digits) -->
  <Style Selector="ToggleButton.filter">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.countpill.header">
    <Setter Property="MinWidth" Value="128" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>
  <Style Selector="Border.countpill.header > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Type pill (image / video): accent outline, readable on any thumbnail -->
  <Style Selector="Border.typepill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="#D01E1E1E" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Separate styles: TextBlock and PathIcon have no common base with Foreground -->
  <Style Selector="Border.typepill TextBlock">
    <Setter Property="Foreground" Value="#FFA640" />
  </Style>
  <Style Selector="Border.typepill PathIcon">
    <Setter Property="Foreground" Value="#FFA640" />
  </Style>
  <!-- Format pill (SNOVA, PNG, MP4 …): fixed width so all look alike -->
  <Style Selector="Border.formatpill">
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.formatpill.overlay">
    <Setter Property="Background" Value="#C01E1E1E" />
  </Style>
  <Style Selector="Border.formatpill.overlay TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Card checkbox: hidden until hover or while something is selected -->
  <Style Selector="CheckBox.cardcheck">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Background" Value="#D01E1E1E" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.thumbcard:pointerover CheckBox.cardcheck, CheckBox.cardcheck.show">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="CheckBox.listcheck">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Delete (topbar): disabled without selection, red when something is selected -->
  <Style Selector="Button.tool.danger:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="Button.tool.danger:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushDangerHover}" />
  </Style>
  <Style Selector="Button.tool.danger:not(:disabled) PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Status pill in the header (FFmpeg missing): red tint, clickable -->
  <Style Selector="Button.statusbad">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Background" Value="#33E53935" />
    <Setter Property="BorderBrush" Value="#B0E53935" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.statusbad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#55E53935" />
    <Setter Property="BorderBrush" Value="#FFE53935" />
  </Style>

  <!-- v0.0.6: text background choices in the editor -->
  <Style Selector="ToggleButton.plate">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.plate:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Empty recycle bin (page header): red label button -->
  <Style Selector="Button.dangerlabel">
    <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.dangerlabel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushDangerHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dangerlabel PathIcon">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Recording toolbar: cancel (discard) in red, symbol only -->
  <Style Selector="Button.cancelred">
    <Setter Property="Background" Value="#C62828" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.cancelred:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E53935" />
  </Style>
  <Style Selector="Button.cancelred:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B71C1C" />
  </Style>

  <!-- Video editor: status pill bottom right ("uncut" neutral, cut = accent) -->
  <Style Selector="Border.cutpill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.cutpill.cut">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
  </Style>
</Styles>
